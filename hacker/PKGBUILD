pkgname="axos-hacker-kit"
pkgver=1.0
pkgrel=1
pkgdesc="Hacker user kit meta-package for AxOS"
arch=('x86_64')

# Network Analysis
depends+=(
  'curl'
  'nmap'
  'wireshark-qt'
  'tcpdump'
  'gnu-netcat'
  'socat'
  'tshark'
)

# Password Cracking
depends+=(
  'hydra'
  'john'
  'hashcat'
)

# Web Security
depends+=(
  'nikto'
  'curl'
  'burpsuite'
)

# Debugging and Reverse Engineering
depends+=(
  'gdb'
  'radare2'
  'binwalk'
  'ghidra'
  'cutter'
)
# System Utilities
depends+=(
  'htop'
  'tmux'

)
install="axos-hacker-kit.install"
package(){
  install -Dm755 "$srcdir/hackerkit-installer.sh" "$pkgdir/usr/bin/hackerkit-installer"
  
}
